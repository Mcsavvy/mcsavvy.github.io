# Copy to .env.local for `vercel dev`. In production, set these in Vercel (see SETUP.md).
# Never commit real values.

# Google service account that can edit the sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=free-websites@your-project.iam.gserviceaccount.com
# The "private_key" value from the JSON key. Keep the \n escapes, wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Resend (https://resend.com), sending domain futurdevs.com must be verified
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL=davidjohn@futurdevs.com

# Optional. Defaults to "Five Free Websites <apply@futurdevs.com>"
# FROM_EMAIL=
