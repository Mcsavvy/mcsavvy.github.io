# Copy to .env.local for `vercel dev`. In production, set these in Vercel (see SETUP.md).
# Never commit real values.

# PocketBase base URL (no /_/)
POCKETBASE_URL=https://backpocket.futurdevs.com
# Random secret. Must match the one in the collection's create rule (see SETUP.md).
# Generate: openssl rand -hex 24
POCKETBASE_CREATE_KEY=
